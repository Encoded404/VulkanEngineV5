{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "displayName": "Base Configuration",
      "description": "Base configuration with common settings",
      "generator": "Ninja Multi-Config",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_COMPILER": "clang++",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "default",
      "inherits": "base",
      "displayName": "Default (vcpkg + Ninja Multi-Config)",
      "description": "Default cross-platform build using vcpkg and Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": {
          "type": "FILEPATH",
          "value": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
        },
        "USE_LIBCPP": "ON",
        "CLANG_TIDY_ENABLED": "OFF",
        "VCPKG_TARGET_TRIPLET": "x64-linux-libcxx",
        "CMAKE_CXX_COMPILER_LAUNCHER": ""
      },
      "environment": {
        "CCACHE_DISABLE": "1"
      },
      "condition": {
        "type": "notEquals",
        "lhs": "$env{VCPKG_ROOT}",
        "rhs": ""
      }
    },
    {
      "name": "windows",
      "displayName": "Windows x86_64 (llvm-mingw + libc++ + vcpkg)",
      "description": "Cross-compile for Windows x86_64 from Linux using the llvm-mingw toolchain (Clang + libc++ with the std module). Requires the llvm-mingw release extracted under ~/opt (or VKENGINE_LLVM_MINGW_ROOT) and CMake >= 4.2 for `import std;`.",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build-windows",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_TOOLCHAIN_FILE": {
          "type": "FILEPATH",
          "value": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
        },
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": {
          "type": "FILEPATH",
          "value": "${sourceDir}/cmake/toolchains/llvm-mingw.cmake"
        },
        "VCPKG_TARGET_TRIPLET": "x64-mingw-libcxx",
        "USE_LIBCPP": "ON",
        "VKENGINE_HOT_RELOAD": "OFF",
        "ENABLE_SANITIZERS": "OFF",
        "CLANG_TIDY_ENABLED": "OFF",
        "BUILD_TESTING": "OFF",
        "CMAKE_CXX_COMPILER_LAUNCHER": ""
      },
      "environment": {
        "CCACHE_DISABLE": "1"
      },
      "condition": {
        "type": "notEquals",
        "lhs": "$env{VCPKG_ROOT}",
        "rhs": ""
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "displayName": "Build Debug",
      "configurePreset": "default",
      "configuration": "Debug",
      "environment": {
        "CCACHE_DISABLE": "1"
      }
    },
    {
      "name": "release",
      "displayName": "Build Release",
      "configurePreset": "default",
      "configuration": "Release",
      "environment": {
        "CCACHE_DISABLE": "1"
      }
    },
    {
      "name": "relwithdebinfo",
      "displayName": "Build RelWithDebInfo",
      "configurePreset": "default",
      "configuration": "RelWithDebInfo",
      "environment": {
        "CCACHE_DISABLE": "1"
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Build Windows x86_64 Debug",
      "configurePreset": "windows",
      "configuration": "Debug",
      "environment": {
        "CCACHE_DISABLE": "1"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Build Windows x86_64 Release",
      "configurePreset": "windows",
      "configuration": "Release",
      "environment": {
        "CCACHE_DISABLE": "1"
      }
    },
    {
      "name": "windows-relwithdebinfo",
      "displayName": "Build Windows x86_64 RelWithDebInfo",
      "configurePreset": "windows",
      "configuration": "RelWithDebInfo",
      "environment": {
        "CCACHE_DISABLE": "1"
      }
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "default",
      "configuration": "Debug",
      "filter": { "exclude": { "label": "gpu" } }
    },
    {
      "name": "release",
      "configurePreset": "default",
      "configuration": "Release",
      "filter": { "exclude": { "label": "gpu" } }
    },
    {
      "name": "relwithdebinfo",
      "configurePreset": "default",
      "configuration": "RelWithDebInfo",
      "filter": { "exclude": { "label": "gpu" } }
    },
    {
      "name": "debug-gpu",
      "configurePreset": "default",
      "configuration": "Debug",
      "displayName": "Debug (GPU tests only)",
      "environment": { "ASAN_OPTIONS": "detect_leaks=0" },
      "filter": { "include": { "label": "gpu" } }
    },
    {
      "name": "release-gpu",
      "configurePreset": "default",
      "configuration": "Release",
      "displayName": "Release (GPU tests only)",
      "environment": { "ASAN_OPTIONS": "detect_leaks=0" },
      "filter": { "include": { "label": "gpu" } }
    },
    {
      "name": "relwithdebinfo-gpu",
      "configurePreset": "default",
      "configuration": "RelWithDebInfo",
      "displayName": "RelWithDebInfo (GPU tests only)",
      "environment": { "ASAN_OPTIONS": "detect_leaks=0" },
      "filter": { "include": { "label": "gpu" } }
    }
  ]
}
