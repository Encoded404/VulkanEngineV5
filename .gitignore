# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# build directories
/build/
/build-windows/
/md-files
/.cache

# local llvm-mingw cross toolchain (see docs/cross-compiling-windows.md)
/toolchains/

# jetbrains directory
/.idea

/**/models/*
/**/textures/*
/vcpkg_installed
/windows-build

# Per-example build-time secrets: real values and the keyring stay local, only
# the format documentation and templates are tracked.
examples/*/secrets/*
!examples/*/secrets/README.md
!examples/*/secrets/manifest.txt
!examples/*/secrets/*.example

# Leaderboard server state (identity, accounts, scores). The identity must not
# be committed: its private half is the server credential.
leaderboard_server.identity
leaderboard_server.accounts.json
*.accounts.json
