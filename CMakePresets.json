{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "displayName": "Base Configuration",
      "description": "Base configuration with common settings",
      "generator": "Ninja Multi-Config",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "default",
      "inherits": "base",
      "displayName": "Clang + libc++ (vcpkg + Ninja Multi-Config)",
      "description": "Default Linux build: Clang with libc++ and the libc++ standard module.",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_TOOLCHAIN_FILE": {
          "type": "FILEPATH",
          "value": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
        },
        "USE_LIBCPP": "ON",
        "VKENGINE_STATIC_LIBCPP": "ON",
        "CLANG_TIDY_ENABLED": "OFF",
        "VCPKG_TARGET_TRIPLET": "x64-linux-libcxx",
        "CMAKE_CXX_COMPILER_LAUNCHER": ""
      },
      "environment": {
        "CCACHE_DISABLE": "1"
      },
      "condition": {
        "type": "notEquals",
        "lhs": "$env{VCPKG_ROOT}",
        "rhs": ""
      }
    },
    {
      "name": "msvc",
      "displayName": "MSVC + Microsoft STL (vcpkg + Ninja Multi-Config)",
      "description": "Native Windows x64 build using MSVC. Run from a Visual Studio Developer PowerShell so cl.exe and the C++ Modules component are visible. import std requires Ninja, not the Visual Studio generator.",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build-msvc",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_TOOLCHAIN_FILE": {
          "type": "FILEPATH",
          "value": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
        },
        "USE_LIBCPP": "OFF",
        "VKENGINE_STEAM_RUNTIME": "off",
        "VKENGINE_WERROR": "OFF",
        "CLANG_TIDY_ENABLED": "OFF",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_CXX_COMPILER_LAUNCHER": "",
        "ENABLE_SANITIZERS": "OFF",
        "VKENGINE_HOT_RELOAD": "ON"
      },
      "environment": {
        "CCACHE_DISABLE": "1"
      },
      "condition": {
        "type": "notEquals",
        "lhs": "$env{VCPKG_ROOT}",
        "rhs": ""
      }
    },
    {
      "name": "windows",
      "displayName": "Windows x86_64 (llvm-mingw + libc++ + vcpkg)",
      "description": "Cross-compile for Windows x86_64 from Linux using the llvm-mingw toolchain (Clang + libc++ with the std module). Requires the llvm-mingw release extracted under ~/opt (or VKENGINE_LLVM_MINGW_ROOT) and CMake >= 4.2 for `import std;`.",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build-windows",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_TOOLCHAIN_FILE": {
          "type": "FILEPATH",
          "value": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
        },
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": {
          "type": "FILEPATH",
          "value": "${sourceDir}/cmake/toolchains/llvm-mingw.cmake"
        },
        "VCPKG_TARGET_TRIPLET": "x64-mingw-libcxx",
        "USE_LIBCPP": "ON",
        "VKENGINE_HOT_RELOAD": "OFF",
        "VKENGINE_WERROR": "ON",
        "ENABLE_SANITIZERS": "OFF",
        "CLANG_TIDY_ENABLED": "OFF",
        "BUILD_TESTING": "OFF",
        "CMAKE_CXX_COMPILER_LAUNCHER": ""
      },
      "environment": {
        "CCACHE_DISABLE": "1"
      },
      "condition": {
        "type": "notEquals",
        "lhs": "$env{VCPKG_ROOT}",
        "rhs": ""
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "displayName": "Build Clang + libc++ Debug",
      "configurePreset": "default",
      "configuration": "Debug",
      "environment": {
        "CCACHE_DISABLE": "1"
      }
    },
    {
      "name": "release",
      "displayName": "Build Clang + libc++ Release",
      "configurePreset": "default",
      "configuration": "Release",
      "environment": {
        "CCACHE_DISABLE": "1"
      }
    },
    {
      "name": "relwithdebinfo",
      "displayName": "Build Clang + libc++ RelWithDebInfo",
      "configurePreset": "default",
      "configuration": "RelWithDebInfo",
      "environment": {
        "CCACHE_DISABLE": "1"
      }
    },
    {
      "name": "msvc-debug",
      "displayName": "Build MSVC Debug",
      "configurePreset": "msvc",
      "configuration": "Debug",
      "environment": {
        "CCACHE_DISABLE": "1"
      }
    },
    {
      "name": "msvc-release",
      "displayName": "Build MSVC Release",
      "configurePreset": "msvc",
      "configuration": "Release",
      "environment": {
        "CCACHE_DISABLE": "1"
      }
    },
    {
      "name": "msvc-relwithdebinfo",
      "displayName": "Build MSVC RelWithDebInfo",
      "configurePreset": "msvc",
      "configuration": "RelWithDebInfo",
      "environment": {
        "CCACHE_DISABLE": "1"
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Build Windows x86_64 Debug",
      "configurePreset": "windows",
      "configuration": "Debug",
      "environment": {
        "CCACHE_DISABLE": "1"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Build Windows x86_64 Release",
      "configurePreset": "windows",
      "configuration": "Release",
      "environment": {
        "CCACHE_DISABLE": "1"
      }
    },
    {
      "name": "windows-relwithdebinfo",
      "displayName": "Build Windows x86_64 RelWithDebInfo",
      "configurePreset": "windows",
      "configuration": "RelWithDebInfo",
      "environment": {
        "CCACHE_DISABLE": "1"
      }
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "default",
      "configuration": "Debug",
      "filter": {
        "exclude": {
          "label": "gpu"
        }
      }
    },
    {
      "name": "release",
      "configurePreset": "default",
      "configuration": "Release",
      "filter": {
        "exclude": {
          "label": "gpu"
        }
      }
    },
    {
      "name": "relwithdebinfo",
      "configurePreset": "default",
      "configuration": "RelWithDebInfo",
      "filter": {
        "exclude": {
          "label": "gpu"
        }
      }
    },
    {
      "name": "msvc-debug",
      "configurePreset": "msvc",
      "configuration": "Debug",
      "filter": {
        "exclude": {
          "label": "gpu"
        }
      }
    },
    {
      "name": "msvc-release",
      "configurePreset": "msvc",
      "configuration": "Release",
      "filter": {
        "exclude": {
          "label": "gpu"
        }
      }
    },
    {
      "name": "msvc-relwithdebinfo",
      "configurePreset": "msvc",
      "configuration": "RelWithDebInfo",
      "filter": {
        "exclude": {
          "label": "gpu"
        }
      }
    },
    {
      "name": "debug-gpu",
      "configurePreset": "default",
      "configuration": "Debug",
      "displayName": "Clang + libc++ Debug (GPU tests only)",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=0"
      },
      "filter": {
        "include": {
          "label": "gpu"
        }
      }
    },
    {
      "name": "release-gpu",
      "configurePreset": "default",
      "configuration": "Release",
      "displayName": "Clang + libc++ Release (GPU tests only)",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=0"
      },
      "filter": {
        "include": {
          "label": "gpu"
        }
      }
    },
    {
      "name": "relwithdebinfo-gpu",
      "configurePreset": "default",
      "configuration": "RelWithDebInfo",
      "displayName": "Clang + libc++ RelWithDebInfo (GPU tests only)",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=0"
      },
      "filter": {
        "include": {
          "label": "gpu"
        }
      }
    },
    {
      "name": "msvc-debug-gpu",
      "configurePreset": "msvc",
      "configuration": "Debug",
      "displayName": "MSVC Debug (GPU tests only)",
      "filter": {
        "include": {
          "label": "gpu"
        }
      }
    }
  ]
}
